# Elevate Charter Academy — demo site configuration
# Copy to .env.local and fill in values as needed. All values are optional;
# with none set, every enrollment CTA routes to an on-site fallback page and
# the Family Interest Form runs in clearly labeled demo mode (nothing is sent).

# Public URL of the deployed site (used for metadata, sitemap, and canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" to allow search engines to index the site (default: noindex)
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- EnrollRise integration -------------------------------------------------
# Supported URL tokens: {schoolId}, {eventId}
NEXT_PUBLIC_ENROLLRISE_SCHOOL_ID=

# Apply Now → Enrollment Application
NEXT_PUBLIC_ENROLLRISE_APPLY_URL=
# Request Information → Lead Capture
NEXT_PUBLIC_ENROLLRISE_INQUIRY_URL=
# Schedule a Tour → Campus Tour Registration
NEXT_PUBLIC_ENROLLRISE_TOUR_URL=
# RSVP → Event Registration (e.g. https://example.enrollrise.test/{schoolId}/events/{eventId})
NEXT_PUBLIC_ENROLLRISE_EVENT_URL=

# Family Interest Form → Prospective Family Record
# Endpoint that accepts a JSON POST of the inquiry payload:
NEXT_PUBLIC_ENROLLRISE_INQUIRY_ENDPOINT=
# OR replace the native form entirely with a hosted EnrollRise form (iframe):
NEXT_PUBLIC_ENROLLRISE_FORM_EMBED_URL=
